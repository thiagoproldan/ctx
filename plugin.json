{
  "name": "ctx",
  "version": "@version@",
  "description": "Keeps Claude Code's context small: routes bulk reads and boilerplate to a cheap non-Claude worker (Gemini via agy, sandboxed), blocks commands that would dump big files into context, and past a context threshold asks for an ekko handoff before the turn ends, then shows how old it is; with the user away, types the /clear and 'continuando' into the session's Konsole tab itself; and stops once a prompt that would re-write a big expired cache.",
  "homepage": "https://github.com/thiagoproldan/ctx",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "@root@/hooks/check-file-size" },
          { "type": "command", "command": "@root@/hooks/guard-secrets" }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          { "type": "command", "command": "@root@/hooks/guard-secrets" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "@root@/hooks/check-bash-read" },
          { "type": "command", "command": "@root@/hooks/guard-work-loss" },
          { "type": "command", "command": "@root@/hooks/guard-secrets" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [{ "type": "command", "command": "@root@/hooks/track-usage" }]
      },
      {
        "matcher": "mcp__.*ekko.*__(create|batch)",
        "hooks": [
          { "type": "command", "command": "@root@/hooks/handoff-written" }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "@root@/hooks/announce-graph" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "@root@/hooks/cold-return" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "@root@/hooks/handoff" }]
      }
    ]
  }
}
