{
  "name": "ctx",
  "version": "@version@",
  "description": "Keeps Claude Code's context small: routes bulk reads and boilerplate to a cheap non-Claude worker (Gemini via agy, sandboxed), blocks commands that would dump big files into context, flags on the status line when the context warrants an ekko handoff, and how old the last one is; with the user away, asks for the handoff before the turn ends and types the /clear and 'continuando' into the session's Konsole tab itself; stops once a prompt that would re-write a big expired cache; and tells the model where the account's 5-hour window stands, refusing past its cap the new work a session starts on its own.",
  "homepage": "https://github.com/thiagoproldan/ctx",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          { "type": "command", "command": "@root@/hooks/check-file-size" },
          { "type": "command", "command": "@root@/hooks/guard-secrets" }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          { "type": "command", "command": "@root@/hooks/guard-secrets" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "@root@/hooks/check-bash-read" },
          { "type": "command", "command": "@root@/hooks/guard-work-loss" },
          { "type": "command", "command": "@root@/hooks/guard-secrets" },
          { "type": "command", "command": "@root@/hooks/guard-window" }
        ]
      },
      {
        "matcher": "Agent|Task|CronCreate|ScheduleWakeup",
        "hooks": [
          { "type": "command", "command": "@root@/hooks/guard-window" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Read",
        "hooks": [{ "type": "command", "command": "@root@/hooks/track-usage" }]
      },
      {
        "matcher": "mcp__.*ekko.*__(create|batch)",
        "hooks": [
          { "type": "command", "command": "@root@/hooks/handoff-written" }
        ]
      },
      {
        "matcher": "*",
        "hooks": [{ "type": "command", "command": "@root@/hooks/window tool" }]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "@root@/hooks/announce-graph" },
          { "type": "command", "command": "@root@/hooks/window start" }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "@root@/hooks/cold-return" },
          { "type": "command", "command": "@root@/hooks/window prompt" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "@root@/hooks/handoff" }]
      }
    ]
  }
}
