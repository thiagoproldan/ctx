#!/usr/bin/env bash
# PreToolUse on Agent, Task, CronCreate, ScheduleWakeup and Bash: past the cap
# on the 5-hour window or the week's, refuse the work a session starts on its
# own (ekko task 808). The decision lives in lib/guard_window.py; this front
# keeps Python off every call while both windows are under their caps, which
# is nearly all of them.

[ "${CTX_DISABLE:-0}" = "1" ] && exit 0

here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
# shellcheck source=../lib/window.sh
. "$here/../lib/window.sh"

read -r five resets seven seven_resets <<<"$(ctx_window)"
[ -n "${five:-}" ] || exit 0
read -r window pct at cap <<<"$(ctx_window_hot "$five" "$resets" "$seven" "$seven_resets")"
[ -n "${window:-}" ] || exit 0

input=$(cat)
# A Bash call pays for Python only when it names claude.
if [[ $input =~ \"tool_name\"[[:space:]]*:[[:space:]]*\"Bash\" ]]; then
  [[ $input =~ (^|[^[:alnum:]_-])claude([^[:alnum:]_-]|$) ]] || exit 0
fi
exec python3 "$here/../lib/guard_window.py" "$window" "$pct" "$at" "$cap" <<<"$input"
