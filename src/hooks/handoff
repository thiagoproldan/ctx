#!/usr/bin/env bash
# Stop: past the handoff threshold, keep the turn open once and ask Claude for
# the handoff, so the user can /clear with nothing lost.
#
# The status line has said "ctx Nk ⚑ handoff" since 2026-09-15, and the clears
# still came late and by eye: at 199k, 349k, 356k, 506k and 719k of context on
# 2026-09-21. Re-reading the context is most of the bill, so every call past
# the right point paid for tokens a handoff would have dropped. A replay of 30
# days of transcripts put the point at ~250k: 22-25% of the bill saved, ~90%
# of what 200k saves with ~30% fewer resets (each reset costs the user a
# /clear and the next session a few minutes of orientation).
#
# It asks at most once per band: at CTX_HANDOFF_TOKENS, again at twice that,
# and so on; a compaction that brings the context back down re-arms the bands
# it came back under. The 5-hour window past CTX_HANDOFF_5H asks once, and
# again only after the window has come back under it. Never while a stop hook
# is already continuing the turn, and never while background work or a
# scheduled wakeup would resume the session -- a /clear then would drop it --
# in which case it asks at the next stop instead.
#
# Nor when a handoff this session wrote is still fresh: less than a tenth of
# the threshold of context since (hooks/handoff-written notes each one). The
# user who ran /handoff at 240k does not want a second one at 250k; the band
# counts as asked. The ask itself is the body of skills/handoff/SKILL.md, the
# text /handoff sends, so the two never drift apart.
#
# The context is the last main-thread call's input, read from the end of the
# transcript (input + cache writes + cache reads); the 5-hour reading is the
# one the status line left for this session, when it is recent.
set -u

[ "${CTX_DISABLE:-0}" = "1" ] && exit 0

int_or() { case "${1:-}" in '' | *[!0-9]*) echo "$2" ;; *) echo "$1" ;; esac; }
threshold=$(int_or "${CTX_HANDOFF_TOKENS:-}" 250000)
limit_5h=$(int_or "${CTX_HANDOFF_5H:-}" 85)
STATE="${CTX_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/ctx}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/handoff.sh
. "$ROOT/lib/handoff.sh"

input=$(cat)
sid="" transcript="" active=false pending=0
eval "$(printf '%s' "$input" | jq -r '
  @sh "sid=\(.session_id // "" | tostring) transcript=\(.transcript_path // "" | tostring) active=\(.stop_hook_active == true) pending=\((.background_tasks // []) + (.session_crons // []) | length)"
' 2>/dev/null)" 2>/dev/null

# The session id names files below: nothing that could leave the directory.
case "$sid" in '' | */* | .*) exit 0 ;; esac
pending=$(int_or "$pending" 0)

# While background work or a scheduled wakeup would resume the session, the
# prompt it sends has nobody to send it again: hooks/cold-return lets prompts
# through as long as this mark is there. Only a Stop hook's input lists them,
# so the mark is kept at every stop, a continued one included.
scheduled="$STATE/cold/$sid.scheduled"
if [ "$pending" -gt 0 ]; then
  { mkdir -p "$STATE/cold" && : >"$scheduled"; } 2>/dev/null
else
  rm -f -- "$scheduled" 2>/dev/null
fi
[ "$active" = "true" ] && exit 0

tokens=$(ctx_context_tokens "$transcript")

five=""
reading="$STATE/sessions/$sid"
if [ "$limit_5h" -gt 0 ] && [ -n "$(find "$reading" -mmin -10 2>/dev/null)" ]; then
  five=$(int_or "$(head -c 8 "$reading" 2>/dev/null | tr -d '\n')" "")
fi

band=0
[ "$threshold" -gt 0 ] && band=$((tokens / threshold))
hot=0
[ -n "$five" ] && [ "$five" -ge "$limit_5h" ] && hot=1

book="$STATE/handoff/$sid"
was_band=0 was_hot=0
[ -r "$book" ] && read -r was_band was_hot <"$book"
was_band=$(int_or "${was_band:-}" 0)
was_hot=$(int_or "${was_hot:-}" 0)
last_band=$was_band last_hot=$was_hot

# Re-arm what came back down. Without a fresh 5-hour reading, its state is
# left as it was.
[ "$band" -lt "$last_band" ] && last_band=$band
[ -n "$five" ] && [ "$hot" -eq 0 ] && last_hot=0

ask_tokens=0
[ "$band" -gt "$last_band" ] && ask_tokens=1
ask_5h=0
[ "$hot" -eq 1 ] && [ "$last_hot" -eq 0 ] && ask_5h=1

# record <band> <hot> -- a failed write must never take the hook down: the
# worst case is one more ask, not a stuck session.
record() {
  mkdir -p "$STATE/handoff" 2>/dev/null
  printf '%s %s\n' "$1" "$2" >"$book" 2>/dev/null || true
}

if { [ "$ask_tokens" -eq 0 ] && [ "$ask_5h" -eq 0 ]; } || [ "$pending" -gt 0 ]; then
  if [ "$last_band" != "$was_band" ] || [ "$last_hot" != "$was_hot" ]; then
    record "$last_band" "$last_hot"
  fi
  exit 0
fi

[ "$ask_tokens" -eq 1 ] && last_band=$band
[ "$ask_5h" -eq 1 ] && last_hot=1
record "$last_band" "$last_hot"
# Readings and books of sessions long gone.
find "$STATE/sessions" "$STATE/handoff" -type f -mtime +7 -delete 2>/dev/null

# shellcheck source=../lib/ledger.sh
. "$ROOT/lib/ledger.sh"

# A handoff written moments ago already holds the session: the band counts as
# asked, and the status line shows how fresh the handoff is.
written=$(ctx_handoff_written "$STATE" "$sid")
if [ -n "$written" ] && [ "$tokens" -ge "$written" ] &&
  [ $((tokens - written)) -lt $((threshold / 10)) ]; then
  CTX_FUNNEL="$STATE/handoff.jsonl" ctx_log handoff-fresh "$sid" \
    tokens "$tokens" written "$written" band "$band"
  exit 0
fi

k() { echo "$(($1 / 1000))k"; }
why=""
[ "$ask_tokens" -eq 1 ] &&
  why="this session's context is $(k "$tokens") tokens, past the $(k "$threshold") handoff threshold"
[ "$ask_5h" -eq 1 ] &&
  why="${why:+$why, and }the 5-hour usage window is at ${five}%, past ${limit_5h}%"

CTX_FUNNEL="$STATE/handoff.jsonl" ctx_log handoff "$sid" \
  tokens "$tokens" five "$five" band "$band"

jq -n --arg m "ctx: $why. $(ctx_handoff_text "$ROOT")
Start no new work in this turn." \
  '{hookSpecificOutput: {hookEventName: "Stop", additionalContext: $m}}'
