#!/usr/bin/env bash
# Stop: with the user away, past the handoff threshold, keep the turn open once
# and ask Claude for the handoff, which bin/auto-reset then clears into a fresh
# session. With the user there, ask nothing: the status line flags the handoff
# from the threshold on, and the user runs /handoff between tasks.
#
# Asking the user who is there held a turn at whatever point the work had
# reached (ekko task 961). Of 30 such asks over 2026-09-23..29, 18 were
# followed by a prompt that went on with the work, and 12 ended the session.
# Claude Code's documentation puts /clear between unrelated tasks, which only
# the user can tell apart. Claude Code's compaction (autoCompactWindow, ~417k
# here) stays the safety net for a user who never clears. Each ask the user
# was spared is logged as handoff-quiet, once a band, to keep the count.
#
# The status line has said "ctx Nk ⚑ handoff" since 2026-09-15, and the clears
# still came late and by eye: at 199k, 349k, 356k, 506k and 719k of context on
# 2026-09-21. Re-reading the context is most of the bill, so every call past
# the right point paid for tokens a handoff would have dropped. A replay of 30
# days of transcripts put the point at ~250k: 22-25% of the bill saved, ~90%
# of what 200k saves with ~30% fewer resets (each reset costs the user a
# /clear and the next session a few minutes of orientation).
#
# A session is alone when the user is away -- nothing typed for
# CTX_AUTO_RESET_IDLE minutes (default 10; 0 turns this off), read off the
# transcript by ctx_last_human -- and the user asked (ekko task 747) for the
# ritual without them. Alone, it asks at most once per band: at
# CTX_HANDOFF_TOKENS, again at twice that, and so on; a compaction that brings
# the context back down re-arms the bands it came back under. Past the 5-hour
# cap, CTX_HANDOFF_5H, the ask adds what the cap asks, once, and again only
# after the window has come back under it. Never while a stop hook is already
# continuing the turn. It asks even with background shells running, telling
# Claude to name them in the handoff: a /clear does not drop a background
# shell -- its notification reaches the fresh session (measured 2026-09-26,
# ekko gotcha 777) -- but the fresh session gets it without knowing why the
# task ran. Once a fresh handoff is written, it starts bin/auto-reset, which
# types /clear and 'continuando' into the session's own Konsole tab. Alone
# means only in Konsole, only in an interactive session (CLAUDE_CODE_ENTRYPOINT
# cli), only past the threshold, and not while anything but a background shell
# is pending: a scheduled wakeup, a monitor or a subagent was not tested
# across a /clear. So the 5-hour cap by itself never asks, and never resets: a
# reset costs the window, it does not spare it. Past the cap on the window
# (ekko task 808) bin/auto-reset types the /clear and not 'continuando': the
# fresh session waits for the user, whose reserve the rest of the window is.
#
# Alone, a handoff this session wrote that is still fresh -- less than a tenth
# of the threshold of context since (hooks/handoff-written notes each one) --
# starts the reset instead of a second ask. The ask itself is the body of
# skills/handoff/SKILL.md, the text /handoff sends, so the two never drift
# apart.
#
# The context is the last main-thread call's input, read from the end of the
# transcript (input + cache writes + cache reads); the 5-hour reading is the
# account's, which the status line leaves (lib/window.sh): past the cap it
# stands until its window ends.
set -u

[ "${CTX_DISABLE:-0}" = "1" ] && exit 0

int_or() { case "${1:-}" in '' | *[!0-9]*) echo "$2" ;; *) echo "$1" ;; esac; }
threshold=$(int_or "${CTX_HANDOFF_TOKENS:-}" 250000)
limit_5h=$(int_or "${CTX_HANDOFF_5H:-}" 85)
STATE="${CTX_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/ctx}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/handoff.sh
. "$ROOT/lib/handoff.sh"
# shellcheck source=../lib/window.sh
. "$ROOT/lib/window.sh"

input=$(cat)
sid="" transcript="" active=false pending=0 unshelled=0
eval "$(printf '%s' "$input" | jq -r '
  (.background_tasks // []) as $tasks | (.session_crons // []) as $crons
  | @sh "sid=\(.session_id // "" | tostring) transcript=\(.transcript_path // "" | tostring) active=\(.stop_hook_active == true) pending=\($tasks + $crons | length) unshelled=\([$tasks[] | select(.type != "shell")] + $crons | length)"
' 2>/dev/null)" 2>/dev/null

# The session id names files below: nothing that could leave the directory.
case "$sid" in '' | */* | .*) exit 0 ;; esac
pending=$(int_or "$pending" 0)
unshelled=$(int_or "$unshelled" 0)

# While background work or a scheduled wakeup would resume the session, the
# prompt it sends has nobody to send it again: hooks/cold-return lets prompts
# through as long as this mark is there. Only a Stop hook's input lists them,
# so the mark is kept at every stop, a continued one included.
scheduled="$STATE/cold/$sid.scheduled"
if [ "$pending" -gt 0 ]; then
  { mkdir -p "$STATE/cold" && : >"$scheduled"; } 2>/dev/null
else
  rm -f -- "$scheduled" 2>/dev/null
fi

tokens=$(ctx_context_tokens "$transcript")

# claude_pid -- Claude Code's own pid: the nearest ancestor of this hook
# named after it.
claude_pid() {
  local p=$PPID c
  while [ "${p:-0}" -gt 1 ]; do
    c=$(cat "/proc/$p/comm" 2>/dev/null)
    case "$c" in *claude*)
      echo "$p"
      return 0
      ;;
    esac
    p=$(awk '$1 == "PPid:" { print $2 }' "/proc/$p/status" 2>/dev/null)
  done
  return 1
}

# Whether the session runs alone: the user away, in a Konsole tab ctx can type
# into, nothing but background shells pending. Read only past the threshold,
# where it can change what happens.
idle_min=$(int_or "${CTX_AUTO_RESET_IDLE:-}" 10)
alone=0 away=0 cpid=""
if [ "$idle_min" -gt 0 ] && [ "$threshold" -gt 0 ] && [ "$tokens" -ge "$threshold" ] &&
  [ "$unshelled" -eq 0 ] && [ "${CLAUDE_CODE_ENTRYPOINT:-}" = "cli" ] &&
  [ -n "${KONSOLE_DBUS_SERVICE:-}" ] && [ -n "${KONSOLE_DBUS_SESSION:-}" ] &&
  cpid=$(claude_pid); then
  at=0 known=0
  read -r at _ known <<<"$(ctx_last_human "$transcript" "$STATE/auto/$sid.typed")"
  if [ "$known" = "1" ]; then
    away=$((($(date +%s) - at) / 60))
    [ "$away" -ge "$idle_min" ] && alone=1
  fi
fi

# shellcheck source=../lib/ledger.sh
. "$ROOT/lib/ledger.sh"

# Alone, with a fresh handoff written: the reset, typed by bin/auto-reset once
# this turn has ended. Detached, with no descriptor of this hook's: Claude
# Code waits for the hook's output to close.
written=$(ctx_handoff_written "$STATE" "$sid")
if [ "$alone" -eq 1 ] && [ -n "$written" ] && [ "$tokens" -ge "$written" ] &&
  [ $((tokens - written)) -lt $((threshold / 10)) ]; then
  if [ ! -d "$STATE/auto/$sid.lock" ]; then
    CTX_FUNNEL="$STATE/handoff.jsonl" ctx_log auto-reset-start "$sid" \
      tokens "$tokens" written "$written" away "$away" pending "$pending"
    setsid -f "$ROOT/bin/auto-reset" "$sid" "$transcript" "$cpid" \
      </dev/null >/dev/null 2>&1
  fi
  exit 0
fi

[ "$active" = "true" ] && exit 0

five=""
[ "$limit_5h" -gt 0 ] && read -r five _ <<<"$(ctx_window)"
five=$(int_or "${five:-}" "")

band=0
[ "$threshold" -gt 0 ] && band=$((tokens / threshold))
hot=0
[ -n "$five" ] && [ "$five" -ge "$limit_5h" ] && hot=1

book="$STATE/handoff/$sid"
was_band=0 was_hot=0
[ -r "$book" ] && read -r was_band was_hot <"$book"
was_band=$(int_or "${was_band:-}" 0)
was_hot=$(int_or "${was_hot:-}" 0)
last_band=$was_band last_hot=$was_hot

# Re-arm what came back down. Without a 5-hour reading -- none yet, or its
# window ended -- its state is left as it was.
[ "$band" -lt "$last_band" ] && last_band=$band
[ -n "$five" ] && [ "$hot" -eq 0 ] && last_hot=0

ask_tokens=0
[ "$band" -gt "$last_band" ] && ask_tokens=1
ask_5h=0
[ "$hot" -eq 1 ] && [ "$last_hot" -eq 0 ] && ask_5h=1

# record <band> <hot> -- a failed write must never take the hook down: the
# worst case is one more ask, not a stuck session.
record() {
  mkdir -p "$STATE/handoff" 2>/dev/null
  printf '%s %s\n' "$1" "$2" >"$book" 2>/dev/null || true
}

# With the user there, nothing is asked (see the top). The book keeps only
# what came back down, so the ask is still owed once the user is away; the
# quiet line comes once for each band and 5-hour state the ask would have come
# at, re-armed once nothing is due. Alone, background shells are no reason to
# wait.
quiet="$STATE/handoff/$sid.quiet"
if [ "$alone" -eq 0 ] || { [ "$ask_tokens" -eq 0 ] && [ "$ask_5h" -eq 0 ]; }; then
  if [ "$last_band" != "$was_band" ] || [ "$last_hot" != "$was_hot" ]; then
    record "$last_band" "$last_hot"
  fi
  if [ "$alone" -eq 0 ] && { [ "$ask_tokens" -eq 1 ] || [ "$ask_5h" -eq 1 ]; }; then
    was_quiet=""
    [ -r "$quiet" ] && read -r was_quiet <"$quiet"
    if [ "$was_quiet" != "$band $hot" ]; then
      { mkdir -p "$STATE/handoff" && echo "$band $hot" >"$quiet"; } 2>/dev/null
      CTX_FUNNEL="$STATE/handoff.jsonl" ctx_log handoff-quiet "$sid" \
        tokens "$tokens" five "$five" band "$band"
    fi
  else
    rm -f -- "$quiet" 2>/dev/null
  fi
  exit 0
fi

[ "$ask_tokens" -eq 1 ] && last_band=$band
[ "$ask_5h" -eq 1 ] && last_hot=1
record "$last_band" "$last_hot"
# Books of sessions long gone, and the readings each session kept before the
# account's (ctx 0.7.0 and earlier).
find "$STATE/sessions" "$STATE/handoff" "$STATE/window/told" -type f -mtime +7 -delete 2>/dev/null


k() { echo "$(($1 / 1000))k"; }
why=""
[ "$ask_tokens" -eq 1 ] &&
  why="this session's context is $(k "$tokens") tokens, past the $(k "$threshold") handoff threshold"
[ "$ask_5h" -eq 1 ] &&
  why="${why:+$why, and }the 5-hour usage window is at ${five}%, past ${limit_5h}%"

CTX_FUNNEL="$STATE/handoff.jsonl" ctx_log handoff "$sid" \
  tokens "$tokens" five "$five" band "$band" alone "$alone"

# Alone, the reset follows the handoff by itself: the /clear above is ctx's to
# type, and the fresh session is all that will know of a task still running.
auto=""
if [ "$alone" -eq 1 ] && [ "$ask_tokens" -eq 1 ] && [ "$hot" -eq 1 ]; then
  auto="
The user has been away for ${away} minutes: once the handoff is written and this turn ends, ctx types /clear into this session's tab, and not '${CTX_AUTO_RESET_PROMPT:-continuando}': past the cap the fresh session waits for the user."
elif [ "$alone" -eq 1 ] && [ "$ask_tokens" -eq 1 ]; then
  auto="
The user has been away for ${away} minutes: once the handoff is written and this turn ends, ctx types /clear and '${CTX_AUTO_RESET_PROMPT:-continuando}' into this session's tab, and a fresh session goes on from the handoff."
  [ "$pending" -gt 0 ] && auto="$auto
Background tasks are still running, and their notifications will reach the fresh session: name each in the handoff, with what it does and the file its output goes to."
fi

rule="Start no new work in this turn."
[ "$hot" -eq 1 ] && rule="$rule $(ctx_window_rule)"
jq -n --arg m "ctx: $why. $(ctx_handoff_text "$ROOT")$auto
$rule" \
  '{hookSpecificOutput: {hookEventName: "Stop", additionalContext: $m}}'
