#!/usr/bin/env bash
# PreToolUse on Read, Grep and Bash: refuse a call that would bring secret
# material into the context, and say what (ekko task 804). The decision lives
# in lib/guard_secrets.py; this front only keeps Python off the calls that
# name nothing secret.

[ "${CTX_DISABLE:-0}" = "1" ] && exit 0

input=$(cat)
# The paths and commands that can show a secret, and the searches that can
# reach one without naming it. Read over the whole input, cwd included.
cues='\.ssh|secrets|age-combined|sops|keys\.txt|\.credentials\.json|hosts\.yml|credential|\.netrc|\.env'
cues+='|(^|[^[:alnum:]_-])(gh|age|gpg2?|pass|secret-tool|kwallet-query|rg|ag|ack|ugrep|ug)([^[:alnum:]_-]|$)'
cues+='|grep[^|;&]*[[:space:]](-[[:alnum:]]*[rR]|--recursive|--dereference-recursive|--directories)'
cues+='|"tool_name": *"Grep"'
IFS=: read -ra roots <<<"${CTX_SECRET_ROOTS:-}"
for extra in "${roots[@]}" "${SOPS_AGE_KEY_FILE:-}"; do
  [ -n "$extra" ] && [[ $input == *"$extra"* ]] && cues='.'
done
[[ $input =~ $cues ]] || exit 0

here=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
exec python3 "$here/../lib/guard_secrets.py" <<<"$input"
