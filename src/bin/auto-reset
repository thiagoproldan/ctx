#!/usr/bin/env bash
# The reset ritual when nobody is at the keyboard: once the session has written
# its handoff and its turn has ended, type /clear into the session's own
# Konsole tab, then the prompt the user would type (CTX_AUTO_RESET_PROMPT,
# 'continuando') into the fresh session. hooks/handoff starts it, detached,
# when the user has been away CTX_AUTO_RESET_IDLE minutes.
#
# Usage: auto-reset <session id> <transcript> <Claude Code's pid>
#
# The user asked for it on 2026-09-26 (ekko task 747): a session left to run
# alone stalled at the handoff, or went on paying for an ever larger context,
# until someone typed /clear and 'continuando'. This types them, and nothing
# else. Before each keystroke it checks that
#  - the tab's foreground process is this session's Claude Code;
#  - the screen shows the session idle: no dialog, where an Enter would
#    approve a tool call, and no turn running;
#  - the input box held the same text for two readings in a row, and, once
#    typed into, holds exactly what was typed. The text it held before may be
#    a prompt suggestion, which typing replaces, or the user's own, which
#    typing adds to: on screen the two look the same (ekko gotcha 784);
#  - the user has typed nothing into the session since this started.
# Anything else ends it, logged in handoff.jsonl as auto-reset-stop, taking
# back what it typed itself, a backspace a character, when nothing else
# changed. Each wait -- for the turn to end, for the fresh session, for it to
# settle -- lasts up to CTX_AUTO_RESET_WAIT seconds (300).
#
# Past the cap on the account's 5-hour window (lib/window.sh, ekko task 808),
# read as the fresh session comes up, it types the /clear and not the prompt:
# the fresh session costs nothing while it waits, and the rest of the window
# is the user's. Logged as auto-reset with held "cap".
set -u

[ "${CTX_DISABLE:-0}" = "1" ] && exit 0

int_or() { case "${1:-}" in '' | *[!0-9]*) echo "$2" ;; *) echo "$1" ;; esac; }
sid="${1:-}" transcript="${2:-}" claude=$(int_or "${3:-}" 0)
wait_s=$(int_or "${CTX_AUTO_RESET_WAIT:-}" 300)
prompt="${CTX_AUTO_RESET_PROMPT:-continuando}"
STATE="${CTX_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/ctx}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/konsole.sh
. "$ROOT/lib/konsole.sh"
# shellcheck source=../lib/ledger.sh
. "$ROOT/lib/ledger.sh"
# shellcheck source=../lib/window.sh
. "$ROOT/lib/window.sh"

# The session id names files below: nothing that could leave the directory.
case "$sid" in '' | */* | .*) exit 0 ;; esac
[ -r "$transcript" ] && [ "$claude" -gt 1 ] || exit 0

log() { CTX_FUNNEL="$STATE/handoff.jsonl" ctx_log "$@"; }
step=start
stop() {
  log auto-reset-stop "$sid" step "$step" why "$1"
  exit 0
}

# One at a time per session: the Stop hook fires again at every turn's end.
mkdir -p "$STATE/auto" 2>/dev/null
lock="$STATE/auto/$sid.lock"
mkdir "$lock" 2>/dev/null || exit 0
trap 'rmdir "$lock" 2>/dev/null' EXIT

ctx_konsole_writable || stop "Konsole refuses typed input over D-Bus (EnableSecuritySensitiveDBusAPI)"
[ "$(ctx_konsole_foreground)" = "$claude" ] || stop "the tab's foreground process is not this session's Claude Code"

# typed_since <transcript> <offset> -- a row the user typed was appended past
# <offset> bytes; with --uuid, print that row's uuid instead.
typed_since() {
  local uuid=false
  [ "$1" = "--uuid" ] && {
    uuid=true
    shift
  }
  tail -c +"$(($2 + 1))" -- "$1" 2>/dev/null | jq -nrR --argjson uuid "$uuid" '
    [inputs | fromjson? | objects | select(.type == "user" and .origin.kind == "human")]
    | if $uuid then (last.uuid // empty) else (length > 0) end' 2>/dev/null
}
size() { stat -c %s -- "$1" 2>/dev/null || echo 0; }

# settle <transcript> <offset> -- wait, a second at a time, for two readings in
# a row of the session idle with the same text in its input box, the tab still
# Claude Code's and nothing typed by the user past <offset>. That text goes in
# $box, for press.
box=""
settle() {
  local seen=0 now last="" why="it never read idle" deadline=$(($(date +%s) + wait_s))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    [ "$(ctx_konsole_foreground)" = "$claude" ] || stop "the tab's foreground process changed"
    [ "$(typed_since "$1" "$2")" = "true" ] && stop "the user typed into the session"
    if now=$(ctx_konsole_screen | ctx_screen_idle --any); then
      if [ "$seen" -eq 1 ] && [ "$now" = "$last" ]; then
        box=$now
        return 0
      fi
      why="idle once, not twice in a row"
      [ "$seen" -eq 1 ] && why="the input box changed between readings"
      seen=1 last=$now
    else
      seen=0 why=$now
    fi
    sleep 1
  done
  stop "not idle within ${wait_s}s: $why"
}

# holds_typed <after> <text> <before> -- <after> is <before> with <text> typed
# in at one place, trailing blanks aside: nothing else changed.
holds_typed() {
  jq -en --arg a "$1" --arg t "$2" --arg b "$3" '
    ($t | length) as $n | ($b | sub("\\s+$"; "")) as $b
    | any(range(0; ($a | length) - $n + 1);
        . as $i | $a[$i:$i + $n] == $t and (($a[:$i] + $a[$i + $n:]) | sub("\\s+$"; "")) == $b)
  ' >/dev/null 2>&1
}

# press <text> -- type <text>; if the box then holds exactly it, Enter. A box
# holding more held the user's own words, not a suggestion: what was typed is
# taken back, a backspace a character, if nothing else changed there.
press() {
  local why after n
  ctx_konsole sendText s "$1" >/dev/null || stop "sendText refused"
  sleep 0.5
  if why=$(ctx_konsole_screen | ctx_screen_idle "$1"); then
    ctx_konsole sendText s $'\r' >/dev/null || stop "sendText refused"
    return 0
  fi
  if after=$(ctx_konsole_screen | ctx_screen_idle --any) && holds_typed "$after" "$1" "$box"; then
    n=$(jq -rn --arg t "$1" '$t | length')
    for _ in $(seq 1 "$n"); do
      ctx_konsole sendText s $'\x7f' >/dev/null
      sleep 0.15
    done
    stop "after typing '$1': $why; taken back"
  fi
  stop "after typing '$1': $why; left as it was"
}

step=clear
base=$(size "$transcript")
settle "$transcript" "$base"
# The fresh session writes a transcript of its own beside this one: a file that
# was not there before the /clear, with the /clear among its first rows. Rows
# of other kinds come first (mode, file-history-snapshot, attachments: the
# /clear was the sixth on 2026-09-26), and another session of this project that
# began with a /clear of its own starts the same way, but its file was there.
dir=$(dirname -- "$transcript")
declare -A before=()
for f in "$dir"/*.jsonl; do before["$f"]=1; done
press /clear

step=fresh
fresh="" deadline=$(($(date +%s) + wait_s))
while [ -z "$fresh" ] && [ "$(date +%s)" -lt "$deadline" ]; do
  sleep 1
  for f in "$dir"/*.jsonl; do
    [ -n "${before[$f]:-}" ] && continue
    head -n 200 -- "$f" 2>/dev/null | grep -q -F '<command-name>/clear</command-name>' && {
      fresh="$f"
      break
    }
  done
done
[ -n "$fresh" ] || stop "no fresh session's transcript within ${wait_s}s of /clear"
fsid=$(basename -- "$fresh" .jsonl)

read -r five _ <<<"$(ctx_window)"
cap=$(ctx_window_cap)
if [ -n "${five:-}" ] && [ "$cap" -gt 0 ] && [ "$five" -ge "$cap" ]; then
  log auto-reset "$sid" to "$fsid" held cap five "$five"
  exit 0
fi

step=prompt
base=$(size "$fresh")
settle "$fresh" "$base"
press "$prompt"

# The row the prompt made is passed over when hooks/handoff reads whether the
# user is there (ctx_last_human's <typed>).
step=verify
uuid=""
for _ in $(seq 1 30); do
  uuid=$(typed_since --uuid "$fresh" "$base")
  [ -n "$uuid" ] && break
  sleep 1
done
[ -n "$uuid" ] || stop "typed '$prompt', and no row of it reached the fresh transcript"
case "$fsid" in '' | */* | .*) ;; *) printf '%s\n' "$uuid" >>"$STATE/auto/$fsid.typed" 2>/dev/null ;; esac
log auto-reset "$sid" to "$fsid"
exit 0
