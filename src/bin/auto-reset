#!/usr/bin/env bash
# The reset ritual when nobody is at the keyboard: once the session has written
# its handoff and its turn has ended, type /clear into the session's own
# Konsole tab, then the prompt the user would type (CTX_AUTO_RESET_PROMPT,
# 'continuando') into the fresh session. hooks/handoff starts it, detached,
# when the user has been away CTX_AUTO_RESET_IDLE minutes.
#
# Usage: auto-reset [--at-reset] <session id> <transcript> <Claude Code's pid>
#
# The user asked for it on 2026-09-26 (ekko task 747): a session left to run
# alone stalled at the handoff, or went on paying for an ever larger context,
# until someone typed /clear and 'continuando'. This types them, and nothing
# else. Before each keystroke it checks that
#  - the tab's foreground process is this session's Claude Code;
#  - the screen shows the session idle: no dialog, where an Enter would
#    approve a tool call, and no turn running;
#  - the input box held the same text for two readings in a row, and, once
#    typed into, holds exactly what was typed. The text it held before may be
#    a prompt suggestion, which typing replaces, or the user's own, which
#    typing adds to: on screen the two look the same (ekko gotcha 784);
#  - the user has typed nothing into the session since this started or, with
#    --at-reset, since the window reset.
# Anything else ends it, logged in handoff.jsonl as auto-reset-stop, taking
# back what it typed itself, a backspace a character, when nothing else
# changed: the box is read again before each backspace. Each wait -- for the turn to end, for the fresh session, for it to
# settle -- lasts up to CTX_AUTO_RESET_WAIT seconds (300).
#
# Past the cap on the account's 5-hour window (lib/window.sh, ekko task 808),
# read as the fresh session comes up, it types the /clear, and the prompt only
# once that window has reset, unless the user has typed into the fresh session
# by then: it costs nothing while it waits, and the rest of the window is the
# user's. Past the week's cap it types the /clear and not the prompt, logged
# as auto-reset with held "cap": the week resets days later.
#
# With --at-reset there is no /clear. hooks/handoff starts it at a stop for
# the 5-hour window -- past its cap, or from 70% of it with a fresh handoff --
# and once that window ends it types the prompt into the same session, logged
# as auto-resume, if no turn of the session ended after the reset and the
# user has been away CTX_AUTO_RESET_IDLE minutes (10), read as hooks/handoff
# reads it. A turn that ended after the reset, the user's or the session's
# own, means the work went on without it. On 2026-10-02 a session that
# stopped for the window waited for the user to come back and type, the
# window long renewed (task 1 on ctx's board).
#
# Either wait reads the window every half minute at most, and ends, logged as
# auto-reset-stop, when the tab's foreground changes, the week passes its cap
# or a day has gone by.
set -u

[ "${CTX_DISABLE:-0}" = "1" ] && exit 0

int_or() { case "${1:-}" in '' | *[!0-9]*) echo "$2" ;; *) echo "$1" ;; esac; }
at_reset=0
[ "${1:-}" = "--at-reset" ] && at_reset=1 && shift
sid="${1:-}" transcript="${2:-}" claude=$(int_or "${3:-}" 0)
wait_s=$(int_or "${CTX_AUTO_RESET_WAIT:-}" 300)
prompt="${CTX_AUTO_RESET_PROMPT:-continuando}"
STATE="${CTX_STATE:-${XDG_STATE_HOME:-$HOME/.local/state}/ctx}"
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# shellcheck source=../lib/konsole.sh
. "$ROOT/lib/konsole.sh"
# shellcheck source=../lib/ledger.sh
. "$ROOT/lib/ledger.sh"
# shellcheck source=../lib/window.sh
. "$ROOT/lib/window.sh"
# shellcheck source=../lib/handoff.sh
. "$ROOT/lib/handoff.sh"
idle=$(($(int_or "${CTX_AUTO_RESET_IDLE:-}" 10) * 60))

# The session id names files below: nothing that could leave the directory.
case "$sid" in '' | */* | .*) exit 0 ;; esac
[ -r "$transcript" ] && [ "$claude" -gt 1 ] || exit 0

log() { CTX_FUNNEL="$STATE/handoff.jsonl" ctx_log "$@"; }
step=start
stop() {
  log auto-reset-stop "$sid" step "$step" why "$1"
  exit 0
}

# One at a time per session: the Stop hook fires again at every turn's end.
# A lock whose process is gone (ctx_auto_busy) is taken over. A signal ends
# this through the EXIT trap, and the lock with it: the long sleeps below run
# in the background, waited for, so that a signal is not held until they end.
mkdir -p "$STATE/auto" 2>/dev/null
lock="$STATE/auto/$sid.lock"
if ! mkdir "$lock" 2>/dev/null; then
  ctx_auto_busy "$STATE" "$sid" && exit 0
  rm -rf -- "$lock"
  mkdir "$lock" 2>/dev/null || exit 0
fi
echo "$$" >"$lock/pid"
trap 'rm -rf -- "$lock"' EXIT
trap 'exit 0' TERM INT HUP

ctx_konsole_writable || stop "Konsole refuses typed input over D-Bus (EnableSecuritySensitiveDBusAPI)"
[ "$(ctx_konsole_foreground)" = "$claude" ] || stop "the tab's foreground process is not this session's Claude Code"

# typed_since <transcript> <offset> -- a row the user typed was appended past
# <offset> bytes; with --uuid, print that row's uuid instead.
typed_since() {
  local uuid=false
  [ "$1" = "--uuid" ] && {
    uuid=true
    shift
  }
  tail -c +"$(($2 + 1))" -- "$1" 2>/dev/null | jq -nrR --argjson uuid "$uuid" '
    [inputs | fromjson? | objects | select(.type == "user" and .origin.kind == "human")]
    | if $uuid then (last.uuid // empty) else (length > 0) end' 2>/dev/null
}
size() { stat -c %s -- "$1" 2>/dev/null || echo 0; }

# settle <transcript> <offset> -- wait, a second at a time, for two readings in
# a row of the session idle with the same text in its input box, the tab still
# Claude Code's and nothing typed by the user past <offset>. That text goes in
# $box, for press.
box=""
settle() {
  local seen=0 now last="" why="it never read idle" deadline=$(($(date +%s) + wait_s))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    [ "$(ctx_konsole_foreground)" = "$claude" ] || stop "the tab's foreground process changed"
    [ "$(typed_since "$1" "$2")" = "true" ] && stop "the user typed into the session"
    if now=$(ctx_konsole_screen | ctx_screen_idle --any); then
      if [ "$seen" -eq 1 ] && [ "$now" = "$last" ]; then
        box=$now
        return 0
      fi
      why="idle once, not twice in a row"
      [ "$seen" -eq 1 ] && why="the input box changed between readings"
      seen=1 last=$now
    else
      seen=0 why=$now
    fi
    sleep 1
  done
  stop "not idle within ${wait_s}s: $why"
}

# holds_typed <after> <text> <before> -- <after> is <before> with <text> typed
# in at one place, trailing blanks aside: nothing else changed.
holds_typed() {
  jq -en --arg a "$1" --arg t "$2" --arg b "$3" '
    ($t | length) as $n | ($b | sub("\\s+$"; "")) as $b
    | any(range(0; ($a | length) - $n + 1);
        . as $i | $a[$i:$i + $n] == $t and (($a[:$i] + $a[$i + $n:]) | sub("\\s+$"; "")) == $b)
  ' >/dev/null 2>&1
}

# press <text> -- type <text>; if the box then holds exactly it, Enter. A box
# holding more held the user's own words, not a suggestion: what was typed is
# taken back, a backspace a character, each only while the box still holds the
# user's words with what is left of the typing in them. On 2026-09-29 the user
# pressed Enter one backspace in, and their prompt went out ending in '/clea'
# (ekko task 967): now the next reading sees it, and the rest is not sent.
press() {
  local why after n left
  ctx_konsole sendText s "$1" >/dev/null || stop "sendText refused"
  sleep 0.5
  if why=$(ctx_konsole_screen | ctx_screen_idle "$1"); then
    ctx_konsole sendText s $'\r' >/dev/null || stop "sendText refused"
    return 0
  fi
  if after=$(ctx_konsole_screen | ctx_screen_idle --any) && holds_typed "$after" "$1" "$box"; then
    n=$(jq -rn --arg t "$1" '$t | length')
    for i in $(seq 1 "$n"); do
      left=$(jq -rn --arg t "$1" --argjson k "$((n - i + 1))" '$t[:$k]')
      if [ "$i" -gt 1 ] && ! { after=$(ctx_konsole_screen | ctx_screen_idle --any) &&
        holds_typed "$after" "$left" "$box"; }; then
        stop "after typing '$1': $why; the box changed after $((i - 1)) of $n backspaces, and the rest were not sent"
      fi
      ctx_konsole sendText s $'\x7f' >/dev/null
      sleep 0.15
    done
    if ! { after=$(ctx_konsole_screen | ctx_screen_idle --any) && holds_typed "$after" "" "$box"; }; then
      stop "after typing '$1': $why; taken back, but the box then held other text"
    fi
    stop "after typing '$1': $why; taken back"
  fi
  stop "after typing '$1': $why; left as it was"
}

# wait_cap <transcript> <offset> -- wait while the 5-hour window is past its
# cap: until its reading has ended or come in under both caps. A row the user
# typed past <offset> ends it.
begun=0 waited=0
wait_cap() {
  local five resets seven seven_resets hot now left
  while :; do
    [ "$(ctx_konsole_foreground)" = "$claude" ] || stop "the tab's foreground process changed"
    [ "$(typed_since "$1" "$2")" = "true" ] && stop "the user typed into the session"
    five="" resets="" seven="" seven_resets="" hot=""
    read -r five resets seven seven_resets <<<"$(ctx_window)"
    read -r hot _ <<<"$(ctx_window_hot "${five:-}" "${resets:-}" "${seven:--}" "${seven_resets:--}")"
    case "${hot:-}" in
    7d) stop "the week is past its cap" ;;
    5h) ;;
    *) return 0 ;;
    esac
    now=$(date +%s)
    [ $((now - begun)) -lt 86400 ] || stop "still past the cap a day later"
    # Half a minute at most, and no later than the window's end.
    left=$((resets - now))
    [ "$left" -gt 30 ] && left=30
    [ "$left" -lt 1 ] && left=1
    sleep "$left" &
    wait $!
  done
}

# turn_ended_after <transcript> <epoch> -- "true" when a turn of the session's
# main thread ended after <epoch>.
turn_ended_after() {
  jq -nR --argjson t "$2" '
    any(inputs | fromjson? | objects
        | select(.type == "system" and .subtype == "turn_duration" and .isSidechain != true)
        | .timestamp // "" | tostring | sub("\\.[0-9]+"; "") | try fromdateiso8601 catch 0;
        . > $t)' <"$1" 2>/dev/null
}
# turn_ended_since <transcript> <offset> -- "true" when one did past <offset>
# bytes.
turn_ended_since() {
  tail -c +"$(($2 + 1))" -- "$1" 2>/dev/null | jq -nR '
    any(inputs | fromjson? | objects;
        .type == "system" and .subtype == "turn_duration" and .isSidechain != true)' 2>/dev/null
}

# wait_resume <transcript> -- wait for the end of the 5-hour window read now,
# if it is from 70% or past its cap (a few seconds otherwise: the window has
# just reset); then until the user has been away $idle seconds, since the
# first turn after their last prompt ended (ctx_last_human). A turn of the
# session that ended after the reset, or a prompt of the user's, ends it: the
# work went on without it. Half a minute at most between readings of the
# window, five seconds once it has reset.
wait_resume() {
  local five resets seven seven_resets hot end now left known ended=0 off=""
  read -r five resets seven seven_resets <<<"$(ctx_window)"
  # The stop that started this writes its own turn's end just after.
  end=$(($(date +%s) + 5))
  case "$(ctx_window_band "${five:-}" "${seven:--}")" in
  3) stop "the week is past its cap" ;;
  1 | 2) [ "$resets" -gt "$end" ] && end=$resets ;;
  esac
  while :; do
    [ "$(ctx_konsole_foreground)" = "$claude" ] || stop "the tab's foreground process changed"
    five="" resets="" seven="" seven_resets="" hot=""
    read -r five resets seven seven_resets <<<"$(ctx_window)"
    read -r hot _ <<<"$(ctx_window_hot "${five:-}" "${resets:-}" "${seven:--}" "${seven_resets:--}")"
    [ "${hot:-}" = 7d ] && stop "the week is past its cap"
    now=$(date +%s)
    left=$((end - now))
    if [ "$left" -le 0 ]; then
      if [ -z "$off" ]; then
        [ "$(turn_ended_after "$1" "$end")" = "true" ] && stop "a turn of the session ended after the window reset"
        off=$(size "$1")
        known=0 ended=0
        read -r _ _ known ended <<<"$(ctx_last_human "$1" "$STATE/auto/$sid.typed")"
        [ "$known" = 1 ] || stop "the transcript does not tell whether the user is there"
        ended=$(int_or "${ended:-}" 0)
      else
        [ "$(typed_since "$1" "$off")" = "true" ] && stop "the user typed into the session after the window reset"
        [ "$(turn_ended_since "$1" "$off")" = "true" ] && stop "a turn of the session ended after the window reset"
      fi
      left=5
      if [ "$ended" -gt 0 ]; then
        left=$((ended + idle - now))
        [ "$left" -le 0 ] && return 0
        [ "$left" -gt 5 ] && left=5
      fi
    fi
    [ $((now - begun)) -lt 86400 ] || stop "still waiting a day later"
    [ "$left" -gt 30 ] && left=30
    sleep "$left" &
    wait $!
  done
}

# prompt_into <transcript> <session> -- type the prompt into the idle session
# that writes <transcript>, and note the row it made, which hooks/handoff
# passes over when it reads whether the user is there (ctx_last_human's
# <typed>).
prompt_into() {
  local base uuid=""
  step=prompt
  base=$(size "$1")
  settle "$1" "$base"
  press "$prompt"
  step=verify
  for _ in $(seq 1 30); do
    uuid=$(typed_since --uuid "$1" "$base")
    [ -n "$uuid" ] && break
    sleep 1
  done
  [ -n "$uuid" ] || stop "typed '$prompt', and no row of it reached the transcript"
  case "$2" in '' | */* | .*) ;; *) printf '%s\n' "$uuid" >>"$STATE/auto/$2.typed" 2>/dev/null ;; esac
}

if [ "$at_reset" -eq 1 ]; then
  step=window
  begun=$(date +%s)
  wait_resume "$transcript"
  waited=$(($(date +%s) - begun))
  prompt_into "$transcript" "$sid"
  log auto-resume "$sid" waited "$waited"
  exit 0
fi

step=clear
base=$(size "$transcript")
settle "$transcript" "$base"
# The fresh session writes a transcript of its own beside this one: a file that
# was not there before the /clear, with the /clear among its first rows. Rows
# of other kinds come first (mode, file-history-snapshot, attachments: the
# /clear was the sixth on 2026-09-26), and another session of this project that
# began with a /clear of its own starts the same way, but its file was there.
dir=$(dirname -- "$transcript")
declare -A before=()
for f in "$dir"/*.jsonl; do before["$f"]=1; done
press /clear

step=fresh
fresh="" deadline=$(($(date +%s) + wait_s))
while [ -z "$fresh" ] && [ "$(date +%s)" -lt "$deadline" ]; do
  sleep 1
  for f in "$dir"/*.jsonl; do
    [ -n "${before[$f]:-}" ] && continue
    head -n 200 -- "$f" 2>/dev/null | grep -q -F '<command-name>/clear</command-name>' && {
      fresh="$f"
      break
    }
  done
done
[ -n "$fresh" ] || stop "no fresh session's transcript within ${wait_s}s of /clear"
fsid=$(basename -- "$fresh" .jsonl)

read -r five resets seven seven_resets <<<"$(ctx_window)"
read -r hot _ <<<"$(ctx_window_hot "${five:-}" "${resets:-}" "${seven:--}" "${seven_resets:--}")"
if [ "${hot:-}" = 7d ]; then
  log auto-reset "$sid" to "$fsid" held cap window "$hot" five "$five" seven "$seven"
  exit 0
fi
if [ "${hot:-}" = 5h ]; then
  step=window
  begun=$(date +%s)
  wait_cap "$fresh" "$(size "$fresh")"
  waited=$(($(date +%s) - begun))
fi

prompt_into "$fresh" "$fsid"
log auto-reset "$sid" to "$fsid" waited "$waited"
exit 0
